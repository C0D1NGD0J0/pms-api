# Copy to .env and fill in. Never commit .env.
# The variables marked REQUIRED are enough to boot the API locally; the rest switch
# on integrations (leave them blank and that feature stays off or fails when used).

# --- Server (REQUIRED) ---------------------------------------------------------
PORT=5001
APP_NAME=PropertyDesk
# Comma-separated; the first one is used in email links. Also the CORS allow-list.
FRONTEND_URL=http://localhost:3000
AUTH_COOKIE_NAME=access_token
ENABLE_CONSOLE_LOGS=true
# Run the cron scheduler in the worker (process type comes from PROCESS_TYPE, default api)
CRON_ENABLED=false

# --- Database & cache (REQUIRED) -----------------------------------------------
# Must be a replica set: the API uses transactions (see README → Quick Start)
DEV_DB_URL=mongodb://localhost:27017/pms-api?replicaSet=rs0
TEST_DB_URL=
PROD_DB_URL=
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=

# --- Auth (REQUIRED — the API refuses to start without the two secrets) --------
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
JWT_EXPIREIN=15m
JWT_REFRESH_EXPIRESIN=7d
JWT_EXTENDED_EXPIRY=
JWT_EXTENDED_REFRESH_TOKEN_EXPIRY=

# --- Email (needed for sign-up activation, invites, password reset) ------------
# Dev: an SMTP sandbox such as Mailtrap, so no real mail goes out
APP_EMAIL_ADDRESS=noreply@example.com
EMAIL_PROVIDER_DEV=mailtrap
EMAIL_PROVIDER_HOST_DEV=sandbox.smtp.mailtrap.io
EMAIL_PROVIDER_PORT_DEV=2525
EMAIL_PROVIDER_USERNAME_DEV=
EMAIL_PROVIDER_PASSWORD_DEV=
EMAIL_PROVIDER_PROD=
EMAIL_PROVIDER_HOST_PROD=
EMAIL_PROVIDER_PORT_PROD=
EMAIL_PROVIDER_USERNAME_PROD=
EMAIL_PROVIDER_PASSWORD_PROD=

# --- File storage: AWS S3 (uploads, documents, PDFs) ---------------------------
AWS_REGION=
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_BUCKET_NAME=
AWS_API_VERSION=v4

# --- Virus scanning: ClamAV (off unless "true") --------------------------------
ENABLE_CLAMAV=false
CLAMDSCAN_SOCKET=/tmp/clamd.sock

# --- Payments: Stripe ----------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_PUBLIC_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=
STRIPE_CANCEL_URL=
STRIPE_REDIRECT_URL=
STRIPE_SETTINGS_REDIRECT_URL=
PLATFORM_FEE_PERCENTAGE=

# --- Payments: Paystack (Nigerian accounts; off unless "true") -----------------
# Rent, maintenance charges and payouts for Nigerian accounts. Subscriptions stay on Stripe.
# Webhooks are signed with the secret key, so there is no separate webhook secret.
FEATURE_PAYSTACK_ENABLED=false
PAYSTACK_SECRET_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co

# --- E-signature: BoldSign -----------------------------------------------------
FEATURE_ESIGNATURE_ENABLED=false
BOLDSIGN_API_KEY=
BOLDSIGN_API_URL=
BOLDSIGN_WEBHOOK_SECRET=
BOLDSIGN_DEFAULT_SENDER_EMAIL=
BOLDSIGN_DEFAULT_SENDER_NAME=

# --- Maps / geocoding ----------------------------------------------------------
GEOCODER_PROVIDER=google
GEOCODER_PROVIDER_KEY=
GMAPIS_KEY=

# --- SMS: Twilio ---------------------------------------------------------------
FEATURE_SMS_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_VERIFY_SERVICE_SID=

# --- Web push ------------------------------------------------------------------
FEATURE_PUSH_NOTIFICATIONS_ENABLED=false
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# --- Passkeys (WebAuthn) -------------------------------------------------------
WEBAUTHN_ENABLED=false
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=PropertyDesk
WEBAUTHN_RP_ORIGIN=http://localhost:3000

# --- AI features ---------------------------------------------------------------
FEATURE_AI_ENABLED=false
FEATURE_AI_MAINTENANCE_TRIAGE_ENABLED=false
FEATURE_AI_INVOICE_SCANNING_ENABLED=false
FEATURE_AI_INSPECTION_ANALYSIS_ENABLED=false
FEATURE_AI_COMMUNICATION_DRAFT_ENABLED=false
FEATURE_AI_REPORT_ANALYSIS_ENABLED=false
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_MAX_TOKENS=

# --- Other feature flags -------------------------------------------------------
# Invoice-provider webhook; only enable behind network-level protection
FEATURE_INVOICE_WEBHOOK_ENABLED=false
FEATURE_INSPECTION_ENABLED=true

# --- Monitoring & queues -------------------------------------------------------
SENTRY_DSN=
BULL_BOARD_BASE_PATH=/api/v1/queues
# Bull Board always runs in development; set true to also expose it elsewhere
ENABLE_BULL_BOARD=false
DLQ_RETENTION_DAYS=30
ERROR_LOG_ARCHIVE_ENABLED=false
