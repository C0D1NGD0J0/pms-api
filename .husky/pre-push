#!/usr/bin/env sh
set -e

echo "Running pre-push checks..."

# Security audit — blocks high/critical production advisories; reviewed exceptions live in
# .audit-allowlist.json (each with a reason and a reviewBy date)
echo "🔒 Running security audit..."
node scripts/audit-prod.js || {
  echo "❌ Fix them, or (if there's no exploit path) add a reviewed entry to .audit-allowlist.json."
  exit 1
}

# Format check
echo "🎨 Checking code formatting..."
npm run prettier:check || {
  echo "❌ Code formatting check failed. Run 'npx prettier --write' to fix."
  exit 1
}

# Lint
echo "📝 Running ESLint..."
npm run lint || {
  echo "❌ Lint errors found. Please fix before pushing."
  exit 1
}

# TypeScript type check (tsconfig.json includes tests/ — jest transpiles them without type-checking)
echo "🔎 Running TypeScript check..."
npx tsc --noEmit -p tsconfig.json || {
  echo "❌ TypeScript errors found. Please fix type errors before pushing."
  exit 1
}

# Unit tests (only files changed vs main)
echo "🧪 Running affected tests..."
npx jest --changedSince=origin/main --passWithNoTests || {
  echo "❌ Tests failed. Please fix the failing tests before pushing."
  exit 1
}

echo "✅ All pre-push checks passed!"