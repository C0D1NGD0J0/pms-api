<table role="presentation" width="100%">
  <tr>
    <td class="content">
      <p>Hi <strong><%= fullname %></strong>,</p>
      <p>
        We received a request to reset the password on your PropertyDesk account. Click the button below to choose a new password.
      </p>
      <%- include("../shared/html/_notice", { text: 'This link expires in <strong>1 hour</strong>. If you didn\'t request a password reset, no action is needed — your account is safe.', type: 'expiry' }) %>
    </td>
  </tr>
  <tr>
    <td class="cta">
      <%- include("../shared/html/_button", { url: resetUrl, label: "Reset Password" }) %>
    </td>
  </tr>
</table>
