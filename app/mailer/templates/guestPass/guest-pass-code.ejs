<table role="presentation" width="100%">
  <tr>
    <td class="content">
      <p>Hi <strong><%= visitorName %></strong>,</p>
      <p>
        You have been granted guest access. Please present this code to security at the entrance gate.
      </p>
    </td>
  </tr>

  <tr>
    <td style="padding: 0 36px;">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0"
        style="background-color: #062f4f; border-radius: 12px; text-align: center;">
        <tr>
          <td style="padding: 28px 20px;">
            <p style="margin: 0 0 6px 0; font-size: 13px; color: rgba(255,255,255,0.75);">
              Your Access Code
            </p>
            <p style="margin: 0; font-size: 38px; font-weight: 800; letter-spacing: 8px; color: #ffffff; font-family: 'Courier New', monospace;">
              <%= code %>
            </p>
            <p style="margin: 10px 0 0 0; font-size: 13px; color: rgba(255,255,255,0.75);">
              Valid for <strong style="color: #ffffff;"><%= expiryMinutes %> minutes</strong>
            </p>
          </td>
        </tr>
      </table>
    </td>
  </tr>

  <tr>
    <td class="content">
      <% var guestRows = [
        { label: "Property", value: propertyName }
      ];
      if (unitNumber) { guestRows.push({ label: "Unit", value: unitNumber }); }
      if (propertyAddress) { guestRows.push({ label: "Address", value: propertyAddress }); }
      guestRows.push({ label: "Your Host", value: hostName });
      if (hostPhone) { guestRows.push({ label: "Contact", value: hostPhone }); }
      %>
      <%- include("../shared/html/_detail-table", { rows: guestRows }) %>

      <%- include("../shared/html/_notice", { text: '<strong>Show this code to security personnel</strong> at the entrance gate. This code will expire automatically after the valid period and can only be used once.', type: 'warning' }) %>
    </td>
  </tr>
</table>
