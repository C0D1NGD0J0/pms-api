<table role="presentation" width="100%">
  <tr>
    <td class="content">
      <p>Hi <strong><%= currentuser.firstName %></strong>,</p>
      <% if (hasRefund && refundAmount > 0) { %>
      <p>
        Your inspection has been reviewed and approved. A refund of
        <strong><%= (refundAmount / 100).toLocaleString(undefined, { style: 'currency', currency: currency || 'USD' }) %></strong> out of your
        <strong><%= (depositAmount / 100).toLocaleString(undefined, { style: 'currency', currency: currency || 'USD' }) %></strong> security deposit will be processed.
      </p>
      <% } else if (hasRefund) { %>
      <p>
        Your inspection has been reviewed and approved. No security deposit refund will be issued.
      </p>
      <% } else { %>
      <p>
        Your inspection has been reviewed and approved. No further action is required on your part.
      </p>
      <% } %>
    </td>
  </tr>

  <tr>
    <td class="content" style="padding-top: 0;">
      <% var approvedRows = [
        { label: "Reference #", value: iuid },
        { label: "Status", value: "Approved", badge: { bg: "#dcfce7", color: "#16a34a" } }
      ];
      if (hasRefund) {
        approvedRows.push({ label: "Deposit Refund", value: ((refundAmount || 0) / 100).toLocaleString(undefined, { style: 'currency', currency: currency || 'USD' }) });
      }
      %>
      <%- include("../shared/html/_detail-table", { rows: approvedRows }) %>
    </td>
  </tr>
</table>
