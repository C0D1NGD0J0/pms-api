<table role="presentation" width="100%">
  <tr>
    <td class="content">
      <h2><%= isFinal ? 'Inspection Rejected' : 'Inspection Needs Revision' %></h2>
      <p>Hi <strong><%= currentuser.firstName %></strong>,</p>
      <% if (isFinal) { %>
      <p>
        Your inspection has been reviewed and <strong>rejected</strong>.
        Please review the details below and contact your property manager for next steps.
      </p>
      <% } else { %>
      <p>
        Your inspection report requires revision before it can be finalized.
        Please review the feedback below.
      </p>
      <% } %>
    </td>
  </tr>

  <tr>
    <td class="content" style="padding-top: 0;">
      <div class="detail-card">
        <h3 style="margin-top: 0;">Details</h3>
        <table class="detail-table">
          <tr>
            <td class="detail-label">Reference #</td>
            <td class="detail-value"><%= iuid %></td>
          </tr>
          <tr>
            <td class="detail-label">Status</td>
            <td class="detail-value" style="color: #dc2626; font-weight: 600;">
              <%= isFinal ? 'Rejected' : 'Revision Required' %>
            </td>
          </tr>
          <tr>
            <td class="detail-label">Reason</td>
            <td class="detail-value"><%= reason %></td>
          </tr>
        </table>
      </div>
    </td>
  </tr>
</table>
