<table role="presentation" width="100%">
  <tr>
    <td class="content">
      <p>Hi <strong><%= currentuser.firstName %></strong>,</p>
      <% if (isFinal) { %>
      <p>
        Your inspection has been reviewed and <strong>rejected</strong>.
        Please review the details below and contact your property manager for next steps.
      </p>
      <% } else { %>
      <p>
        Your inspection report requires revision before it can be finalized.
        Please review the feedback below.
      </p>
      <% } %>
    </td>
  </tr>

  <tr>
    <td class="content" style="padding-top: 0;">
      <%- include("../shared/html/_detail-table", { rows: [
        { label: "Reference #", value: iuid },
        { label: "Status", value: isFinal ? 'Rejected' : 'Revision Required', badge: { bg: "#fef2f2", color: "#dc2626" } },
        { label: "Reason", value: reason }
      ]}) %>
    </td>
  </tr>
</table>
