<table role="presentation" width="100%">
  <tr>
    <td class="content">
      <p>Hi <strong><%= currentuser.firstName %></strong>,</p>
      <p>
        A <strong><%= inspectionType %></strong> inspection has been scheduled for your unit.
        <strong>You are responsible for conducting this inspection</strong> by walking through each room,
        rating the condition of items, and uploading photos as evidence.
      </p>
    </td>
  </tr>

  <tr>
    <td class="content" style="padding-top: 0;">
      <%- include("../shared/html/_detail-table", { rows: [
        { label: "Reference #", value: iuid },
        { label: "Type", value: inspectionType },
        { label: "Scheduled Date", value: scheduledDate }
      ]}) %>

      <div style="margin-top: 20px; background-color: #f8fafb; border: 1px solid #e8edf2; border-radius: 10px; padding: 22px 24px;">
        <h3 style="margin-top: 0; font-family: 'DM Sans', system-ui, sans-serif; font-size: 15px; color: #1e293b;">What You Need To Do</h3>
        <ol style="margin: 0; padding-left: 20px; line-height: 1.8; font-family: 'DM Sans', system-ui, sans-serif; font-size: 14px; color: #1e293b;">
          <li>Log in to your tenant portal and open this inspection</li>
          <li>Walk through each room and rate the condition of every item</li>
          <li>Take <strong>at least 2 photos per room</strong> where you find any damage or issues</li>
          <li>Add notes describing any problems you observe</li>
          <li>Submit the inspection when all rooms are complete</li>
        </ol>
      </div>

      <%- include("../shared/html/_notice", { text: 'Photos are required for any room with damage. Please ensure images are clear and show the full extent of any issues found.', type: 'info' }) %>
    </td>
  </tr>
</table>
