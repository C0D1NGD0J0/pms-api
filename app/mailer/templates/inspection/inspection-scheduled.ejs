<table role="presentation" width="100%">
  <tr>
    <td class="content">
      <h2>Inspection Scheduled</h2>
      <p>Hi <strong><%= currentuser.firstName %></strong>,</p>
      <p>
        A <strong><%= inspectionType %></strong> inspection has been scheduled for your unit.
        <strong>You are responsible for conducting this inspection</strong> by walking through each room,
        rating the condition of items, and uploading photos as evidence.
      </p>
    </td>
  </tr>

  <tr>
    <td class="content" style="padding-top: 0;">
      <div class="detail-card">
        <h3 style="margin-top: 0;">Inspection Details</h3>
        <table class="detail-table">
          <tr>
            <td class="detail-label">Reference #</td>
            <td class="detail-value"><%= iuid %></td>
          </tr>
          <tr>
            <td class="detail-label">Type</td>
            <td class="detail-value"><%= inspectionType %></td>
          </tr>
          <tr>
            <td class="detail-label">Scheduled Date</td>
            <td class="detail-value"><%= scheduledDate %></td>
          </tr>
        </table>
      </div>

      <div class="detail-card" style="margin-top: 20px;">
        <h3 style="margin-top: 0;">What You Need To Do</h3>
        <ol style="margin: 0; padding-left: 20px; line-height: 1.8;">
          <li>Log in to your tenant portal and open this inspection</li>
          <li>Walk through each room and rate the condition of every item</li>
          <li>Take <strong>at least 2 photos per room</strong> where you find any damage or issues</li>
          <li>Add notes describing any problems you observe</li>
          <li>Submit the inspection when all rooms are complete</li>
        </ol>
      </div>

      <div class="notice-box info" style="margin-top: 20px;">
        Photos are required for any room with damage. Please ensure images are clear and show the full extent of any issues found.
      </div>
    </td>
  </tr>
</table>
