<table role="presentation" width="100%">
  <tr>
    <td class="content">
      <p>Hi <strong><%= tenantName %></strong>,</p>
      <p>
        This notice confirms that your lease agreement for <strong><%= propertyAddress %></strong> has expired.
      </p>
    </td>
  </tr>

  <tr>
    <td class="content" style="padding-top: 0;">
      <%- include("../shared/html/_detail-table", { rows: [
        { label: "Lease Number", value: leaseNumber },
        { label: "Property", value: propertyAddress },
        ...(unitNumber ? [{ label: "Unit", value: unitNumber }] : []),
        { label: "Lease End Date", value: '<span style="color: #dc2626;">' + new Date(endDate).toLocaleDateString() + '</span>' }
      ], variant: 'amber' }) %>
    </td>
  </tr>

  <% if (leaseUrl) { %>
  <tr>
    <td class="cta">
      <%- include("../shared/html/_button", { url: leaseUrl, label: "View Lease Details", colorClass: "btn-muted" }) %>
    </td>
  </tr>
  <% } %>

  <tr>
    <td class="content">
      <h3>Next Steps</h3>
      <ul>
        <li><strong>Move-Out Inspection:</strong> Your property manager will schedule a move-out inspection. Please ensure the property is in good condition.</li>
        <li><strong>Property Condition:</strong> Return the property in the same condition as move-in, excluding normal wear and tear</li>
        <li><strong>Keys &amp; Access:</strong> Return all keys, access cards, and remotes to your property manager</li>
        <li><strong>Forwarding Address:</strong> Provide your new address for security deposit processing</li>
        <li><strong>Utilities:</strong> Cancel or transfer all utility accounts effective on your move-out date</li>
      </ul>

      <%- include("../shared/html/_notice", { text: 'Your security deposit will be processed in accordance with applicable law. You will receive an itemized statement and any refund due within the legally required timeframe after move-out.', type: 'info' }) %>

      <p style="font-size: 14px; color: #64748b; margin-top: 20px;">
        Questions about the move-out process? Contact your property manager at
        <a href="mailto:<%= propertyManagerEmail %>"><%= propertyManagerEmail %></a> or <%= propertyManagerPhone %>.
      </p>

      <p style="font-size: 12px; color: #94a3b8; margin-top: 20px; border-top: 1px solid #e2e8f0; padding-top: 16px;">
        This is an official notice. Please retain this email for your records.
      </p>
    </td>
  </tr>
</table>
