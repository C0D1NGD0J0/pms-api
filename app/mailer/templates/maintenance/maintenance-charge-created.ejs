<%
  var _autoDebit = typeof isAutoDebit !== 'undefined' && isAutoDebit;
  var _dueDate = (typeof dueDateFormatted !== 'undefined' && dueDateFormatted)
    ? dueDateFormatted
    : new Date(dueDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
  var _amount = (typeof amountFormatted !== 'undefined' && amountFormatted)
    ? amountFormatted
    : (amountInCents / 100).toFixed(2) + ' ' + (currency || 'USD').toUpperCase();
  var _payUrl = (typeof paymentUrl !== 'undefined' && paymentUrl) ? paymentUrl : '';
%>
<table role="presentation" width="100%">
  <tr>
    <td class="content">
      <p>
        A maintenance charge has been added to your account for work completed at your property.
        <% if (_autoDebit) { %>
        You can pay it yourself until <strong><%= _dueDate %></strong>. After that date it will be
        charged to your payment method on file (bank debits are made only after you receive advance notice of the debit).
        <% } else { %>
        Please pay it by <strong><%= _dueDate %></strong>.
        <% } %>
      </p>
    </td>
  </tr>

  <tr>
    <td class="content" style="padding-top: 0;">
      <%
        var _rows = [
          { label: 'Reference #', value: mruid }
        ];
        if (jobTitle) {
          _rows.push({ label: 'Job', value: jobTitle });
        }
        _rows.push({ label: 'Amount Due', value: _amount });
        _rows.push({ label: 'Due Date', value: _dueDate });
      %>
      <%- include("../shared/html/_detail-table", { rows: _rows, variant: 'amber' }) %>
    </td>
  </tr>

  <% if (_payUrl) { %>
  <tr>
    <td class="content" style="text-align: center; padding: 24px 32px;">
      <%- include("../shared/html/_button", { url: _payUrl, label: 'Pay Now', colorClass: 'btn-accent' }) %>
    </td>
  </tr>
  <% } %>

  <tr>
    <td class="content">
      <p style="font-size: 13px; color: #64748b;">
        Questions about this charge? Contact your property manager directly.
      </p>
    </td>
  </tr>
</table>
