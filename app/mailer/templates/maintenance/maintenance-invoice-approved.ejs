<table role="presentation" width="100%">
  <tr>
    <td class="content">
      <p>
        Your invoice for the maintenance job below has been <strong style="color: #16a34a;">approved</strong>. Payment will be processed according to the agreed payment terms.
      </p>
    </td>
  </tr>

  <tr>
    <td class="content" style="padding-top: 0;">
      <%
        var _rows = [
          { label: 'Reference #', value: request.mruid },
          { label: 'Job', value: request.title }
        ];
        if (request.invoice) {
          _rows.push({ label: 'Approved Amount', value: '$' + (request.invoice.amount / 100).toFixed(2) + ' ' + request.invoice.currency.toUpperCase() });
          _rows.push({ label: 'Approved By', value: approvedBy.firstName || approvedBy.email });
          _rows.push({ label: 'Approved On', value: new Date().toLocaleDateString() });
        }
      %>
      <%- include("../shared/html/_detail-table", { rows: _rows }) %>
    </td>
  </tr>

  <tr>
    <td class="content">
      <p style="font-size: 14px; color: #64748b;">
        For questions about payment timing, contact the property manager directly.
      </p>
    </td>
  </tr>
</table>
