<table role="presentation" width="100%">
  <tr>
    <td class="content">
      <% if (_status === 'submitted') { %>
      <p>
        A vendor has submitted an invoice for the maintenance request below. Please review and approve or reject it at your earliest convenience.
      </p>
      <% } else if (_status === 'approved') { %>
      <p>
        Your invoice for the maintenance job below has been <strong style="color: #16a34a;">approved</strong>. Payment will be processed according to the agreed payment terms.
      </p>
      <% } else if (_status === 'rejected') { %>
      <p>
        Your invoice for the maintenance job below has been <strong style="color: #dc2626;">rejected</strong>. Please review the reason and submit a corrected invoice.
      </p>
      <% } %>
    </td>
  </tr>

  <tr>
    <td class="content" style="padding-top: 0;">
      <%
        var _rows = [
          { label: 'Reference #', value: request.mruid },
          { label: 'Job', value: request.title }
        ];

        if (_status === 'submitted') {
          _rows.push({ label: 'Invoice Amount', value: '$' + (amount / 100).toFixed(2) + ' ' + ((request.invoice && request.invoice.currency) ? request.invoice.currency.toUpperCase() : 'USD') });
          _rows.push({ label: 'Submitted', value: new Date().toLocaleDateString() });
          if (request.invoice && request.invoice.description) {
            _rows.push({ label: 'Description', value: request.invoice.description });
          }
        } else if (_status === 'approved' && request.invoice) {
          _rows.push({ label: 'Approved Amount', value: '$' + (request.invoice.amount / 100).toFixed(2) + ' ' + request.invoice.currency.toUpperCase() });
          _rows.push({ label: 'Approved By', value: approvedBy.firstName || approvedBy.email });
          _rows.push({ label: 'Approved On', value: new Date().toLocaleDateString() });
        } else if (_status === 'rejected') {
          _rows.push({ label: 'Rejected By', value: rejectedBy.firstName || rejectedBy.email });
          _rows.push({ label: 'Reason', value: rejectionReason });
        }
      %>
      <%- include("../shared/html/_detail-table", { rows: _rows }) %>
    </td>
  </tr>

  <tr>
    <td class="content">
      <% if (_status === 'submitted') { %>
      <p>Log in to the portal to <strong>approve or reject</strong> this invoice. Approving will record it as a maintenance expense.</p>
      <% } else if (_status === 'approved') { %>
      <p style="font-size: 14px; color: #64748b;">
        For questions about payment timing, contact the property manager directly.
      </p>
      <% } else if (_status === 'rejected') { %>
      <p>Log in to the portal to submit a revised invoice addressing the reason above.</p>
      <p style="font-size: 14px; color: #64748b;">
        If you believe this rejection is in error, contact <strong><%= rejectedBy.firstName || rejectedBy.email %></strong><% if (rejectedBy.email) { %> at <a href="mailto:<%= rejectedBy.email %>"><%= rejectedBy.email %></a><% } %>.
      </p>
      <% } %>
    </td>
  </tr>
</table>
