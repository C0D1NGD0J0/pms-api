<table role="presentation" width="100%">
  <tr>
    <td class="content">
      <p>
        A vendor has submitted an invoice for the maintenance request below. Please review and approve or reject it at your earliest convenience.
      </p>
    </td>
  </tr>

  <tr>
    <td class="content" style="padding-top: 0;">
      <%
        var _rows = [
          { label: 'Reference #', value: request.mruid },
          { label: 'Job Title', value: request.title },
          { label: 'Invoice Amount', value: '$' + (amount / 100).toFixed(2) + ' ' + ((request.invoice && request.invoice.currency) ? request.invoice.currency.toUpperCase() : 'USD') },
          { label: 'Submitted', value: new Date().toLocaleDateString() }
        ];
        if (request.invoice && request.invoice.description) {
          _rows.push({ label: 'Description', value: request.invoice.description });
        }
      %>
      <%- include("../shared/html/_detail-table", { rows: _rows }) %>
    </td>
  </tr>

  <tr>
    <td class="content">
      <p>Log in to the portal to <strong>approve or reject</strong> this invoice. Approving will record it as a maintenance expense.</p>
    </td>
  </tr>
</table>
