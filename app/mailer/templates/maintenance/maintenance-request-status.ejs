<table role="presentation" width="100%">
  <tr>
    <td class="content">
      <% if (_status === 'created') { %>
      <p>Hi <strong><%= currentuser.firstName || currentuser.email %></strong>,</p>
      <p>
        We've received your maintenance request and added it to the queue. Our team will review it and assign a vendor as soon as possible. You'll be notified once someone is assigned.
      </p>
      <% } else if (_status === 'assigned') { %>
      <p>Hi <strong><%= vendor.firstName || vendor.email %></strong>,</p>
      <p>
        <strong><%= assignedBy.firstName || assignedBy.email %></strong> has assigned you a maintenance request. Please review the details below and <strong>accept or decline within 24 hours</strong>.
      </p>
      <% } else if (_status === 'accepted') { %>
      <p>Hi <strong><%= tenant && (tenant.firstName || tenant.email) ? (tenant.firstName || tenant.email) : 'Resident' %></strong>,</p>
      <p>
        Good news — a vendor has <strong>accepted</strong> your maintenance request and will be in touch to schedule the work.
      </p>
      <% } else if (_status === 'declined') { %>
      <p>
        A vendor has declined the maintenance request below. The request has been returned to <strong>Open</strong> status and requires reassignment.
      </p>
      <% } else if (_status === 'completed') { %>
      <p>Hi <strong><%= tenant && (tenant.firstName || tenant.email) ? (tenant.firstName || tenant.email) : 'Resident' %></strong>,</p>
      <p>
        Your maintenance request has been <strong>completed</strong>. We hope everything is in order.
      </p>
      <% } %>
    </td>
  </tr>

  <tr>
    <td class="content" style="padding-top: 0;">
      <%
        var _rows = [
          { label: 'Reference #', value: request.mruid },
          { label: 'Title', value: request.title }
        ];

        if (_status === 'created') {
          _rows.push({ label: 'Category', value: request.category.replace(/_/g, ' ') });
          _rows.push({ label: 'Priority', value: request.priority });
          _rows.push({ label: 'Status', value: 'Open', badge: { bg: '#dbeafe', color: '#0369a1' } });
          if (request.preferredDate) {
            _rows.push({ label: 'Preferred Date', value: new Date(request.preferredDate).toLocaleDateString() });
          }
          if (request.availabilityWindows && request.availabilityWindows.length > 0) {
            _rows.push({ label: 'Availability', value: request.availabilityWindows.join(', ').replace(/_/g, ' ') });
          }
        } else if (_status === 'assigned') {
          _rows.push({ label: 'Description', value: request.description });
          _rows.push({ label: 'Category', value: request.category.replace(/_/g, ' ') });
          _rows.push({ label: 'Priority', value: request.priority.toUpperCase(), badge: { bg: '#fef3c7', color: '#92400e' } });
          _rows.push({ label: 'Property Entry', value: request.permissionToEnter ? 'Permission granted' : 'Must coordinate with resident' });
          if (request.scheduledDate) {
            _rows.push({ label: 'Scheduled Date', value: new Date(request.scheduledDate).toLocaleDateString() });
          }
          if (request.estimatedCost) {
            _rows.push({ label: 'Estimated Cost', value: '$' + (request.estimatedCost / 100).toFixed(2) });
          }
          if (request.preferredDate) {
            _rows.push({ label: 'Resident Preferred Date', value: new Date(request.preferredDate).toLocaleDateString() });
          }
          if (request.availabilityWindows && request.availabilityWindows.length > 0) {
            _rows.push({ label: 'Resident Availability', value: request.availabilityWindows.join(', ').replace(/_/g, ' ') });
          }
        } else if (_status === 'accepted') {
          _rows.push({ label: 'Category', value: request.category.replace(/_/g, ' ') });
          _rows.push({ label: 'Priority', value: request.priority.toUpperCase(), badge: { bg: '#fef3c7', color: '#92400e' } });
          if (request.assignedTechnician && request.assignedTechnician.name) {
            var _techVal = request.assignedTechnician.name;
            if (request.assignedTechnician.phone) { _techVal += ' — ' + request.assignedTechnician.phone; }
            _rows.push({ label: 'Technician', value: _techVal });
          }
          if (request.scheduledDate) {
            _rows.push({ label: 'Scheduled Date', value: new Date(request.scheduledDate).toLocaleDateString() });
          }
        } else if (_status === 'declined') {
          _rows.push({ label: 'Priority', value: request.priority });
          _rows.push({ label: 'Status', value: 'Open — awaiting reassignment', badge: { bg: '#dbeafe', color: '#0369a1' } });
          if (reason) {
            _rows.push({ label: 'Vendor Reason', value: reason });
          }
        } else if (_status === 'completed') {
          _rows.push({ label: 'Category', value: request.category.replace(/_/g, ' ') });
          if (request.completedAt) {
            _rows.push({ label: 'Completed On', value: new Date(request.completedAt).toLocaleDateString() });
          }
          if (request.completionNotes && request.completionNotes.length > 0) {
            _rows.push({ label: 'Completion Notes', value: request.completionNotes[request.completionNotes.length - 1].note });
          }
        }
      %>
      <%- include("../shared/html/_detail-table", { rows: _rows, variant: _status === 'declined' ? 'amber' : undefined }) %>
      <% if (_status === 'created') { %>
      <p style="font-size: 13px; color: #64748b; margin-top: 12px;">
        Keep your reference number for follow-ups: <strong><%= request.mruid %></strong>
      </p>
      <% } %>
    </td>
  </tr>

  <tr>
    <td class="content">
      <% if (_status === 'created') { %>
      <%/* no extra action needed */%>
      <% } else if (_status === 'assigned') { %>
      <p>
        Log in to the portal to <strong>accept or decline</strong> this assignment. If you decline, the request will be reassigned to another vendor.
      </p>
      <p style="font-size: 14px; color: #64748b;">
        Questions? Contact <strong><%= assignedBy.firstName || assignedBy.email %></strong><% if (assignedBy.email) { %> at <a href="mailto:<%= assignedBy.email %>"><%= assignedBy.email %></a><% } %>.
      </p>
      <% } else if (_status === 'accepted') { %>
      <p>You will be contacted to confirm the schedule. Please ensure access is available at the agreed time.</p>
      <p style="font-size: 14px; color: #64748b;">
        Log in to the resident portal to track the status of your request.
      </p>
      <% } else if (_status === 'declined') { %>
      <p>Log in to the portal to assign a new vendor to this request.</p>
      <% } else if (_status === 'completed') { %>
      <p>If the issue has not been resolved or you have concerns, please contact your property manager.</p>
      <p style="font-size: 14px; color: #64748b;">
        Log in to the resident portal to view your request history.
      </p>
      <% } %>
    </td>
  </tr>
</table>
