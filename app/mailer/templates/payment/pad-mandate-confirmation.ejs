<table role="presentation" width="100%">
  <tr>
    <td class="content">
      <p>Hi <strong><%= tenantName %></strong>,</p>
      <p>
        This confirms that you have authorized <strong><%= payeeName %></strong> to debit your bank account under the following terms:
      </p>

      <%- include("../shared/html/_detail-table", { rows: [
        { label: "Amount", value: amount },
        { label: "Frequency", value: frequency },
        ...(typeof debitDay !== 'undefined' && debitDay ? [{ label: "Debit Day", value: 'Day ' + debitDay + ' of each month' }] : []),
        { label: "Start Date", value: startDate }
      ]}) %>

      <%- include("../shared/html/_notice", { text: '<strong>Cancellation Rights:</strong> ' + cancellationRights, type: 'info' }) %>

      <p>
        If you did not authorize this debit or believe this is an error, please contact
        <strong><%= payeeName %></strong> immediately.
      </p>
    </td>
  </tr>
</table>
