<%
  var _val = function (v) { return typeof v !== 'undefined' && v ? v : ''; };
  var _debitDate = _val(typeof debitDate !== 'undefined' ? debitDate : '');
  var _reference = _val(typeof reference !== 'undefined' ? reference : (typeof pytuid !== 'undefined' ? pytuid : ''));
  var _last4 = _val(typeof accountLast4 !== 'undefined' ? accountLast4 : '');
  var _type = _val(typeof paymentType !== 'undefined' ? paymentType : '') || 'Payment';
  var _mandate = _val(typeof mandateReference !== 'undefined' ? mandateReference : '');
  var _phone = _val(typeof payeePhone !== 'undefined' ? payeePhone : '');
  var _email = _val(typeof payeeEmail !== 'undefined' ? payeeEmail : '');
  var _address = _val(typeof payeeAddress !== 'undefined' ? payeeAddress : '');
  var _url = _val(typeof paymentsUrl !== 'undefined' ? paymentsUrl : '');
%>
<table role="presentation" width="100%">
  <tr>
    <td class="content">
      <p>Hi <strong><%= tenantName %></strong>,</p>
      <p>
        This is advance notice that <strong><%= payeeName %></strong> will debit
        <strong><%= amount %></strong> (<%= currency %>) from your bank account under your
        pre-authorized debit (PAD) agreement<% if (_debitDate) { %> on <strong><%= _debitDate %></strong><% } %>.
      </p>
    </td>
  </tr>

  <tr>
    <td class="content" style="padding-top: 0;">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color: #f8fafb; border: 1px solid #e8edf2; border-radius: 10px; font-family: 'DM Sans', system-ui, sans-serif; font-size: 14px;">
        <tr><td style="padding: 18px 24px;">
          <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
            <% if (_debitDate) { %><tr><td style="padding: 6px 0; color: #64748b; width: 38%;">Debit date</td><td style="padding: 6px 0; color: #1e293b; font-weight: 500;"><%= _debitDate %></td></tr><% } %>
            <tr><td style="padding: 6px 0; color: #64748b; width: 38%;">Amount</td><td style="padding: 6px 0; color: #1e293b; font-weight: 500;"><%= amount %> (<%= currency %>)</td></tr>
            <tr><td style="padding: 6px 0; color: #64748b;">For</td><td style="padding: 6px 0; color: #1e293b; font-weight: 500;"><%= _type %></td></tr>
            <% if (_reference) { %><tr><td style="padding: 6px 0; color: #64748b;">Reference</td><td style="padding: 6px 0; color: #1e293b; font-weight: 500;"><%= _reference %></td></tr><% } %>
            <% if (_last4) { %><tr><td style="padding: 6px 0; color: #64748b;">Bank account</td><td style="padding: 6px 0; color: #1e293b; font-weight: 500;">ending in <%= _last4 %></td></tr><% } %>
            <% if (_mandate) { %><tr><td style="padding: 6px 0; color: #64748b;">PAD agreement</td><td style="padding: 6px 0; color: #1e293b; font-weight: 500;"><%= _mandate %></td></tr><% } %>
            <tr><td style="padding: 6px 0; color: #64748b;">Payee</td><td style="padding: 6px 0; color: #1e293b; font-weight: 500;"><%= payeeName %></td></tr>
          </table>
        </td></tr>
      </table>
    </td>
  </tr>

  <tr>
    <td class="content">
      <%- include("../shared/html/_notice", { text: 'Please make sure enough funds are in your account on the debit date to avoid failed-payment fees from your bank.', type: 'warning' }) %>
      <p>
        You can pay this amount another way before the debit date from your payments page. If you believe this
        debit is wrong, or you want to cancel or change your PAD agreement, contact <strong><%= payeeName %></strong>
        before the debit date:
      </p>
      <p style="font-size: 14px; color: #334155;">
        <% if (_phone) { %>Phone: <%= _phone %><br /><% } %>
        <% if (_email) { %>Email: <%= _email %><br /><% } %>
        <% if (_address) { %>Address: <%= _address %><% } %>
      </p>
    </td>
  </tr>

  <% if (_url) { %>
  <tr>
    <td class="cta">
      <%- include("../shared/html/_button", { url: _url, label: "View Payment" }) %>
    </td>
  </tr>
  <% } %>

  <tr>
    <td class="content">
      <p style="font-size: 12px; color: #64748b;">
        You have certain recourse rights if any debit does not comply with your PAD agreement. For example, you have the
        right to receive reimbursement for any debit that is not authorized or is not consistent with your PAD agreement.
        To obtain more information on your recourse rights, contact your financial institution or visit www.payments.ca.
      </p>
    </td>
  </tr>
</table>
