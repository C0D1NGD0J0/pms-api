<%
  var _autoDebit = typeof isAutoDebit !== 'undefined' && isAutoDebit;
  var _dueDate = isNaN(new Date(dueDate).getTime())
    ? dueDate
    : new Date(dueDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
%>
<table role="presentation" width="100%">
  <tr>
    <td class="content">
      <p>Hi <strong><%= tenantName %></strong>,</p>
      <p>
        Your property manager has created a new payment request for
        <strong><%= propertyAddress %></strong>.
      </p>
    </td>
  </tr>

  <tr>
    <td class="content" style="padding-top: 0;">
      <%- include("../shared/html/_detail-table", { rows: [
        { label: "Property", value: propertyAddress },
        ...(unitNumber ? [{ label: "Unit", value: unitNumber }] : []),
        { label: "Type", value: paymentType },
        { label: "Amount Due", value: amountDue },
        { label: "Due Date", value: _dueDate },
        ...(description ? [{ label: "Note", value: description }] : [])
      ]}) %>
    </td>
  </tr>

  <% if (paymentUrl) { %>
  <tr>
    <td class="cta">
      <%- include("../shared/html/_button", { url: paymentUrl, label: "View & Pay", colorClass: "btn-success" }) %>
    </td>
  </tr>
  <% } %>

  <tr>
    <td class="content">
      <p>
        <% if (_autoDebit) { %>
        You can pay early using the button above. Otherwise your linked payment method will be charged automatically
        on or after the due date (bank debits are made only after you receive advance notice of the debit).
        <% } else { %>
        Please pay by <strong><%= _dueDate %></strong> using your usual payment method.
        <% } %>
        If you have any questions about this charge, please contact your property manager directly.
      </p>
    </td>
  </tr>
</table>
