<table role="presentation" width="100%">
  <tr>
    <td class="content">
      <p>Hi <strong><%= fullname %></strong>,</p>
      <p>
        Welcome to <strong style="color: #153D4D;">PropertyDesk</strong>. You're one step away from accessing your account — click the button below to complete your setup.
      </p>
      <%- include("../shared/html/_notice", { text: 'This link expires in <strong>2 hours</strong>. If you didn\'t create an account, you can safely ignore this email.', type: 'expiry' }) %>
    </td>
  </tr>
  <tr>
    <td class="cta">
      <%- include("../shared/html/_button", { url: activationUrl, label: "Activate My Account" }) %>
    </td>
  </tr>
</table>
