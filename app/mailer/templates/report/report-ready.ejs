<table role="presentation" width="100%">
  <tr>
    <td class="content">
      <p>Hi,</p>
      <p>Your <strong><%= periodLabel %></strong> property report for <strong><%= clientName %></strong> has been generated and is ready for download.</p>
    </td>
  </tr>

  <tr>
    <td class="content" style="padding-top: 0;">
      <%- include("../shared/html/_detail-table", { rows: [
        { label: "Report", value: filename },
        { label: "Period", value: periodLabel },
        { label: "Client", value: clientName }
      ]}) %>

      <div style="text-align: center; margin: 28px 0;">
        <%- include("../shared/html/_button", { url: presignedUrl, label: "Download Report", colorClass: "btn-accent" }) %>
      </div>

      <%- include("../shared/html/_notice", { text: '<strong>Note:</strong> This download link expires in 1 hour. After that, you can generate a new link from the Reports page in your dashboard.', type: 'warning' }) %>
    </td>
  </tr>
</table>
