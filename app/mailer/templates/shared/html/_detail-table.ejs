<%
  // Params: rows (array of { label, value, badge? { bg, color } }), variant? ('default' | 'amber' | 'cream')
  var _bg = '#f8fafb';
  var _border = '#e8edf2';
  var _divider = '#e8edf2';
  if (typeof variant !== 'undefined') {
    if (variant === 'amber') { _bg = '#fffbf5'; _border = '#f0e6d4'; _divider = '#f0e6d4'; }
    if (variant === 'cream') { _bg = '#fffbf2'; _border = '#f0e6d4'; _divider = '#e8dcc8'; }
  }
%>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color: <%= _bg %>; border: 1px solid <%= _border %>; border-radius: 10px;">
  <tr>
    <td style="padding: 22px 24px;">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="font-family: 'DM Sans', system-ui, sans-serif; font-size: 14px;">
        <% rows.forEach(function(row, i) { %>
        <tr>
          <td style="padding: 7px 0; color: #64748b; width: 38%;"><%= row.label %></td>
          <td style="padding: 7px 0; color: #1e293b; font-weight: 500;">
            <% if (row.badge) { %>
            <span style="display: inline-block; background-color: <%= row.badge.bg %>; color: <%= row.badge.color %>; font-size: 12px; font-weight: 600; padding: 3px 12px; border-radius: 20px;"><%- row.value %></span>
            <% } else { %>
            <%- row.value %>
            <% } %>
          </td>
        </tr>
        <% if (i < rows.length - 1) { %>
        <tr>
          <td colspan="2" style="border-bottom: 1px solid <%= _divider %>; height: 1px;"></td>
        </tr>
        <% } %>
        <% }); %>
      </table>
    </td>
  </tr>
</table>
