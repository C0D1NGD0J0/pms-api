<%
  var _brand = typeof brand !== 'undefined' && brand ? brand : null;
  var _appName = _brand ? _brand.appName : (typeof appName !== 'undefined' ? appName : 'PropertyDesk');
  var _companyAddress = _brand ? _brand.companyAddress : 'WeTalkingTech Labs Inc. &mdash; 1111B S Governors Ave #90461, Dover, DE 19904';
  var _supportEmail = _brand ? _brand.supportEmail : 'support@propertydesk.live';
%>
<tr>
  <td style="background-color: #f8fafb; border-top: 1px solid #e8edf2; padding: 24px 40px; text-align: center; font-family: 'DM Sans', Arial, Helvetica, sans-serif; font-size: 13px; color: #94a3b8; line-height: 1.7;">
    <p style="margin: 0 0 6px 0;">
      &copy; <%= year %> <%= _appName %>. All rights reserved.
    </p>
    <p style="margin: 0 0 10px 0; font-size: 12px; color: #b0b8c4;">
      <%- _companyAddress %>
    </p>
    <p style="margin: 0; font-size: 12px;">
      <a href="mailto:<%= _supportEmail %>" style="color: #64748b; text-decoration: underline;">Support</a>
      &nbsp;&middot;&nbsp;
      <a href="#" style="color: #64748b; text-decoration: underline;">Privacy</a>
      <% if (typeof preferencesUrl !== 'undefined' && preferencesUrl) { %>
      &nbsp;&middot;&nbsp;
      <a href="<%= preferencesUrl %>" style="color: #64748b; text-decoration: underline;">Preferences</a>
      <% } %>
    </p>
  </td>
</tr>
