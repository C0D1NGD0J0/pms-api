<%
  var _icon = typeof icon !== 'undefined' && icon ? icon : '&#x1F3E0;';
%>
<div style="display: inline-block; width: 100px; height: 100px; border-radius: 50%; background: rgba(255,255,255,0.08); border: 2px solid rgba(255,255,255,0.2); text-align: center; line-height: 100px; margin-bottom: 20px;">
  <div style="display: inline-block; width: 72px; height: 72px; border-radius: 50%; background: rgba(255,255,255,0.12); text-align: center; line-height: 72px;">
    <span style="font-size: 36px; color: #ffffff;"><%- _icon %></span>
  </div>
</div>
