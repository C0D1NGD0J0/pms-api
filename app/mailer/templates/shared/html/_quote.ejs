<%
  // Params: message (string), author? (string)
  var _author = typeof author !== 'undefined' && author ? author : '';
%>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin: 16px 0;">
  <tr>
    <td style="border-left: 3px solid #D9952B; background-color: #fffbf5; border-radius: 0 8px 8px 0; padding: 14px 20px;">
      <p style="margin: 0; font-family: 'DM Sans', system-ui, sans-serif; font-style: italic; color: #6b5c3e; font-size: 14px; line-height: 1.6;">
        &ldquo;<%= message %>&rdquo;
      </p>
      <% if (_author) { %>
      <p style="margin: 8px 0 0 0; font-family: 'DM Sans', system-ui, sans-serif; font-size: 13px; color: #94a3b8; font-style: normal;">
        &mdash; <%= _author %>
      </p>
      <% } %>
    </td>
  </tr>
</table>
