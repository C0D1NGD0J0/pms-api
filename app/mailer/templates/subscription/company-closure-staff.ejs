<table role="presentation" width="100%">
  <tr>
    <td class="content">
      <p>Hello,</p>
      <p>
        We are writing to inform you that <strong><%= companyName %></strong> has closed
        their account on our platform, effective <strong><%= effectiveDate %></strong>.
      </p>
    </td>
  </tr>

  <tr>
    <td class="content" style="padding-top: 0;">
      <%- include("../shared/html/_notice", { text: '<strong>What This Means For You</strong><br><ul style="margin: 8px 0 0 0; padding-left: 20px; line-height: 1.8;"><li>Your account has been set to <strong>read-only</strong> mode</li><li>You will no longer be able to create or modify resources</li><li>Your existing data will remain accessible for reference</li><li>No further action is required on your part</li></ul>', type: 'info' }) %>
    </td>
  </tr>

  <tr>
    <td class="content">
      <p>
        If you have any questions about this change, please contact the account administrator
        or reach out to our support team.
      </p>
    </td>
  </tr>
</table>
