<table role="presentation" width="100%">
  <tr>
    <td class="content">
      <h2>Account Closure Notice</h2>
      <p>Hello,</p>
      <p>
        We are writing to inform you that <strong><%= companyName %></strong> has closed
        their account on our platform, effective <strong><%= effectiveDate %></strong>.
      </p>
    </td>
  </tr>

  <tr>
    <td class="content" style="padding-top: 0;">
      <div class="detail-card">
        <h3 style="margin-top: 0;">What This Means For You</h3>
        <ul style="line-height: 1.8;">
          <li>Your account has been set to <strong>read-only</strong> mode</li>
          <li>You will no longer be able to create or modify resources</li>
          <li>Your existing data will remain accessible for reference</li>
          <li>No further action is required on your part</li>
        </ul>
      </div>
    </td>
  </tr>

  <tr>
    <td class="content">
      <p>
        If you have any questions about this change, please contact the account administrator
        or reach out to our support team.
      </p>
    </td>
  </tr>
</table>
