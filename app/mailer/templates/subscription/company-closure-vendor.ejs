<table role="presentation" width="100%">
  <tr>
    <td class="content">
      <p>Hello,</p>
      <p>
        We are writing to inform you that <strong><%= companyName %></strong> has closed
        their account on our platform, effective <strong><%= effectiveDate %></strong>.
      </p>
    </td>
  </tr>

  <tr>
    <td class="content" style="padding-top: 0;">
      <%- include("../shared/html/_notice", { text: '<strong>What This Means For You</strong><br><ul style="margin: 8px 0 0 0; padding-left: 20px; line-height: 1.8;"><li>Your vendor account has been <strong>disconnected</strong> from ' + companyName + '</li><li>Any pending payouts will be processed according to the existing schedule</li><li>You will no longer receive new service requests from this client</li><li>Your account on our platform remains active for other clients</li></ul>', type: 'info' }) %>
    </td>
  </tr>

  <tr>
    <td class="content">
      <p>
        If you have questions about pending payouts or this disconnection, please contact
        our support team.
      </p>
    </td>
  </tr>
</table>
