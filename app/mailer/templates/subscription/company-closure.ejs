<table role="presentation" width="100%">
  <tr>
    <td class="content">
      <p>Hello,</p>
      <% if (_audience === 'owner') { %>
      <p>
        This confirms that your account for <strong><%= companyName %></strong> has been
        closed on <strong><%= effectiveDate %></strong>.
      </p>
      <% } else { %>
      <p>
        We are writing to inform you that <strong><%= companyName %></strong> has closed
        their account on our platform, effective <strong><%= effectiveDate %></strong>.
      </p>
      <% } %>
    </td>
  </tr>

  <% if (_audience === 'owner') { %>
  <tr>
    <td class="content" style="padding-top: 0;">
      <div style="background-color: #f8fafb; border: 1px solid #e8edf2; border-radius: 10px; padding: 22px 24px;">
        <h3 style="margin-top: 0; font-family: 'DM Sans', system-ui, sans-serif; font-size: 15px; color: #1e293b;">Closure Summary</h3>
        <ul style="line-height: 1.8; font-family: 'DM Sans', system-ui, sans-serif; font-size: 14px; color: #1e293b;">
          <li><strong><%= leasesTerminated %></strong> lease(s) terminated</li>
          <li><strong><%= staffDisconnected %></strong> staff account(s) disconnected</li>
          <li><strong><%= vendorsDisconnected %></strong> vendor(s) disconnected</li>
        </ul>
      </div>
    </td>
  </tr>
  <% } %>

  <tr>
    <td class="content" style="padding-top: 0;">
      <% if (_audience === 'owner') { %>
      <%- include("../shared/html/_notice", { text: '<strong>What Happens Next</strong><br><ul style="margin: 8px 0 0 0; padding-left: 20px; line-height: 1.8;"><li>Move-out inspections have been auto-scheduled for all active leases</li><li>Security deposit refunds will be processed after inspections complete</li><li>All staff and vendor access has been revoked</li><li>Your account is now suspended &mdash; data is retained but inaccessible</li></ul>', type: 'warning' }) %>
      <% } else if (_audience === 'staff') { %>
      <%- include("../shared/html/_notice", { text: '<strong>What This Means For You</strong><br><ul style="margin: 8px 0 0 0; padding-left: 20px; line-height: 1.8;"><li>Your account has been set to <strong>read-only</strong> mode</li><li>You will no longer be able to create or modify resources</li><li>Your existing data will remain accessible for reference</li><li>No further action is required on your part</li></ul>', type: 'info' }) %>
      <% } else if (_audience === 'tenant') { %>
      <%- include("../shared/html/_notice", { text: '<strong>What This Means For You</strong><br><ul style="margin: 8px 0 0 0; padding-left: 20px; line-height: 1.8;"><li>Your lease has been <strong>terminated</strong> as part of this closure</li><li>Any security deposit refund will be processed after your move-out inspection</li><li>Outstanding payments prior to closure remain on record</li><li>You will no longer have access to the tenant portal for this property</li><li>Your payment and lease history will remain available for reference</li></ul>', type: 'info' }) %>
      <% } else if (_audience === 'vendor') { %>
      <%- include("../shared/html/_notice", { text: '<strong>What This Means For You</strong><br><ul style="margin: 8px 0 0 0; padding-left: 20px; line-height: 1.8;"><li>Your vendor account has been <strong>disconnected</strong> from ' + companyName + '</li><li>Any pending payouts will be processed according to the existing schedule</li><li>You will no longer receive new service requests from this client</li><li>Your account on our platform remains active for other clients</li></ul>', type: 'info' }) %>
      <% } %>
    </td>
  </tr>

  <tr>
    <td class="content">
      <% if (_audience === 'owner') { %>
      <p>
        If this was done in error, please contact our support team within 30 days
        to discuss account reactivation options.
      </p>
      <% } else if (_audience === 'staff') { %>
      <p>
        If you have any questions about this change, please contact the account administrator
        or reach out to our support team.
      </p>
      <% } else if (_audience === 'tenant') { %>
      <p>
        If you have any questions about your lease, security deposit, or outstanding payments,
        please contact your property manager directly or reach out to our support team.
      </p>
      <% } else if (_audience === 'vendor') { %>
      <p>
        If you have questions about pending payouts or this disconnection, please contact
        our support team.
      </p>
      <% } %>
    </td>
  </tr>
</table>
